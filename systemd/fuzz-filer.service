# File one private security advisory on nifeos/nife for each held fuzz finding that has none yet.
# fuzz-filer.timer starts it every 30 minutes. It runs the root-owned copy in /usr/local/bin, never a
# file in a clone, reads the filer token that fuzz-token@filer.service writes, and keeps its ledger in
# /var/lib/fuzz-filer. See docs/fuzz-filer.md.
# Name: provisional.
#
# User=lane is the account the supervisor runs as, the only one that can read the held directory
# today, and the reader fuzz-token gives the filer token by default. Whether the filer gets its own
# account is an open question for the architect (docs/fuzz-filer.md, "Which account it runs as").
[Unit]
Description=File held fuzz findings as private advisories on nifeos/nife
Documentation=https://github.com/nifeos/fuzz-host/blob/main/docs/fuzz-filer.md
Wants=network-online.target fuzz-token@filer.service
After=network-online.target fuzz-token@filer.service

[Service]
Type=oneshot
User=lane
Group=lane
Environment=PATH=/usr/bin:/bin
Environment=NIFE_FUZZ_HOME=/home/lane/fuzz
ExecStart=/usr/local/bin/fuzz-filer run
TimeoutStartSec=10min
LimitCORE=0
# The ledger: /var/lib/fuzz-filer, owned by the service's user, mode 0700.
StateDirectory=fuzz-filer
StateDirectoryMode=0700
UMask=0077
# It reads the held directory and windows.tsv and writes only its ledger.
ProtectHome=read-only
ProtectSystem=strict
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
