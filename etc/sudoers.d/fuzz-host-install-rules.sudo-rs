# fuzz-host-install-rules: the fuzz account may install fuzz-filer's rules from one commit on main
# of nifeos/fuzz-host, and nothing else. For sudo-rs, which allows no wildcard inside an argument
# list, only a trailing `*` for any arguments; the program refuses every command line but one
# commit id. docs/fuzz-filer.md, "Install a merged rules change", which installs it as
# /etc/sudoers.d/fuzz-host-install-rules after visudo -c.
# Name: provisional, as are this file's name and the program's path.
Defaults!/usr/local/sbin/fuzz-host-install-rules env_reset
lane ALL=(root) NOPASSWD: /usr/local/sbin/fuzz-host-install-rules *
