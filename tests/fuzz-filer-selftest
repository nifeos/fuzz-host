#!/usr/bin/python3 -IS
"""tests/fuzz-filer-selftest: bin/fuzz-filer against a synthetic held directory and a fake GitHub.

No real finding, no real token and no network. The test builds a held directory and a windows.tsv
shaped like the supervisor's in a temporary directory, with planted seeds no real window would use,
writes a token file shaped like fuzz-token's with a made-up token, and serves the advisory API from
a stub on 127.0.0.1. It checks:

- one create per finding, for each of the three held classes, each with a package (ecosystem and
  name) and a vulnerable version range and no patched versions, the class, driver, commit, seed and
  replay line in the description, and no seed in the summary;
- idempotence: a second run creates nothing and lists nothing; the same log under a second name is
  not filed again; a run that dies after GitHub made the advisory, and a lost ledger, are both
  recovered from the listing without a second create; a failed listing files nothing;
- that a 422 leaves the finding pending and the next run files it once;
- that a finding whose log and row disagree is refused by id and the others are filed;
- refusal, with no request sent, of a token file that is missing, a link, not root's, of the wrong
  mode or group, of the wrong profile (contents:write), for another repository, stale, expired, or
  claiming too long a life; and of an API address that is not loopback or GitHub;
- rate awareness: a 403 rate limit and a low remaining count stop the run with exit 75 after at most
  one create, and --max bounds the creates of one run;
- that a redirect is refused and the redirect target hears nothing;
- that a create answered without a package and range is recorded (never filed twice) and reported;
- that --dry-run sends nothing; that a ledger of the wrong mode or a held lock is refused;
- cause dedupe (section 17): logs that differ only in seeds, timings, numbers, line numbers and
  build lines share one signature and one advisory, filed for the oldest; a different message, file,
  class or driver is a separate signature; the ledger keeps a count and the newest commit; a ledger
  from before signatures still reads and refiles nothing; a signature already in the ledger is not
  refiled, even after its first log is gone; the cap of 10 a run holds;
- that nothing the filer printed in any of these runs, and nothing in its ledger, holds a planted
  seed, a held log's name, a replay line or the token, even when GitHub's error message echoes them.

Name: provisional.
"""

import contextlib
import fcntl
import grp
import http.server
import importlib.machinery
import importlib.util
import io
import json
import os
import shutil
import subprocess
import sys
import tempfile
import threading
import urllib.parse
from datetime import datetime, timedelta, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
FILER = os.path.join(ROOT, "bin", "fuzz-filer")
MY_GROUP = grp.getgrgid(os.getegid()).gr_name
ADV = "/repos/nifeos/nife/security-advisories"

# Planted values. No real window starts this low or this oddly; the test greps every output for them.
FIRSTS = {"finding": "73914000000", "crash": "73915000000", "hang": "73916000000",
          "odd": "73917000000"}
REPLAY_SEED = "73914000417"
TOKEN = "ghs_selftestNotARealToken0123456789abcd"
COMMIT = "abc1234"

failures = []
outputs = []


def check(name, ok, detail=""):
    print("%s %s" % ("ok  " if ok else "FAIL", name))
    if not ok:
        failures.append(name)
        if detail:
            print("     " + str(detail)[:600])


def load():
    loader = importlib.machinery.SourceFileLoader("fuzz_filer", FILER)
    spec = importlib.util.spec_from_loader("fuzz_filer", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


MOD = load()


class Stub:
    """The fake GitHub: records every request and answers as `mode` says."""

    def __init__(self):
        self.reset()

    def reset(self):
        self.requests = []
        self.advisories = []
        self.mode = "ok"
        self.remaining = 4999
        self.page_size = 100
        self.n = 0

    def ghsa(self):
        self.n += 1
        alphabet = "23456789cfghjmpqrvwx"
        s = "".join(alphabet[(self.n * 7 + i) % 20] for i in range(12))
        return "GHSA-%s-%s-%s" % (s[0:4], s[4:8], s[8:12])


STUB = Stub()


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, headers=()):
        raw = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("X-RateLimit-Remaining", str(STUB.remaining))
        for k, v in headers:
            self.send_header(k, v)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        u = urllib.parse.urlsplit(self.path)
        STUB.requests.append(("GET", self.path, None, self.headers.get("Authorization")))
        if u.path.endswith("/security-advisories") and u.path != ADV:
            # Another repository's listing: answers, and holds none of this one's advisories.
            return self.send(200, [])
        if u.path != ADV:
            return self.send(404, {"message": "Not Found"})
        if STUB.mode == "list-fails":
            return self.send(500, {"message": "listing broke"})
        q = urllib.parse.parse_qs(u.query)
        start = int(q.get("after", ["0"])[0])
        page = STUB.advisories[start:start + STUB.page_size]
        headers = []
        if start + STUB.page_size < len(STUB.advisories):
            nxt = "http://%s:%d%s?per_page=100&after=%d" % (
                self.server.server_address[0], self.server.server_address[1], ADV,
                start + STUB.page_size)
            if STUB.mode == "evil-next":
                nxt = "http://%s:%d/repos/nifeos/other/security-advisories?after=%d" % (
                    self.server.server_address[0], self.server.server_address[1],
                    start + STUB.page_size)
            headers.append(("Link", '<%s>; rel="next"' % nxt))
        self.send(200, page, headers)

    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", "0"))))
        STUB.requests.append(("POST", self.path, body, self.headers.get("Authorization")))
        if self.path != ADV:
            return self.send(404, {"message": "Not Found"})
        if STUB.mode == "rate-403":
            # A secondary rate limit: the hourly count is still high.
            return self.send(403, {"message": "API rate limit exceeded"}, [("Retry-After", "60")])
        if STUB.mode == "422-echo":
            # A hostile or careless error that echoes the request back.
            replay = body["description"].split("```sh\n")[1].split("\n")[0]
            return self.send(422, {"message": "Validation failed: " + replay + " in " +
                                   body["description"],
                                   "errors": [{"field": "vulnerable_version_range",
                                               "code": "invalid"},
                                              {"field": "seed " + REPLAY_SEED, "code": "x"}]})
        if STUB.mode == "redirect":
            self.send_response(307)
            self.send_header("Location", "http://127.0.0.1:%d%s" % (DECOY_PORT, ADV))
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        adv = {"ghsa_id": STUB.ghsa(), "state": "draft", "summary": body["summary"],
               "description": body["description"], "vulnerabilities": body["vulnerabilities"]}
        STUB.advisories.append(adv)
        if STUB.mode == "drop-after-create":
            self.wfile.flush()
            self.connection.shutdown(2)
            return
        answer = dict(adv)
        if STUB.mode == "no-package":
            answer["vulnerabilities"] = []
        if STUB.mode == "low-after-create":
            STUB.remaining = 50
        self.send(201, answer)


DECOY_HITS = []


class Decoy(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_POST(self):
        DECOY_HITS.append(self.headers.get("Authorization"))
        self.send_response(201)
        self.end_headers()


class Quiet(http.server.ThreadingHTTPServer):
    def handle_error(self, request, client_address):
        pass


def serve(handler):
    s = Quiet(("127.0.0.1", 0), handler)
    threading.Thread(target=s.serve_forever, daemon=True).start()
    return s


SERVER = serve(Handler)
DECOY = serve(Decoy)
DECOY_PORT = DECOY.server_address[1]
API = "http://127.0.0.1:%d" % SERVER.server_address[1]


def shape_checks():
    for name, tok in (("classic", "ghs_" + "aB3_" * 9), ("long", "ghs_5571801_" + "eyJ-a_b" * 72 + ".x.y"),
                      ("dotted", "ghs_1.2.3"), ("hyphenated", "ghs_a-b")):
        check("the filer's shape check accepts a %s token" % name, bool(MOD.TOKEN_SHAPE.fullmatch(tok)))
    for name, tok in (("empty", ""), ("spaced", "ghs_a b"), ("newline", "ghs_a\nb"),
                      ("quoted", 'ghs_a"b'), ("dollar", "ghs_a$b"), ("leading-hyphen", "-ab"),
                      ("over-long", "a" * 1025)):
        check("the filer's shape check rejects a %s token" % name, not MOD.TOKEN_SHAPE.fullmatch(tok))


def write_token(path, perms="repository_advisories:write", repos="nifeos/nife", minutes=50,
                mode=0o440):
    if os.path.lexists(path):
        os.chmod(path, 0o600) if not os.path.islink(path) else None
        os.unlink(path)
    expires = (datetime.now(timezone.utc) + timedelta(minutes=minutes)).strftime(
        "%Y-%m-%dT%H:%M:%SZ")
    with open(path, "w") as f:
        f.write("# fuzz-token: test\nGH_TOKEN=%s\nGH_TOKEN_EXPIRES_AT=%s\n"
                "GH_TOKEN_PERMISSIONS=%s\nGH_TOKEN_REPOSITORIES=%s\n" % (TOKEN, expires, perms,
                                                                          repos))
    os.chmod(path, mode)


def held_log(held, first, lines):
    name = "20261103T%s0000Z-%s.log" % (first[3:5], first)
    with open(os.path.join(held, name), "w") as f:
        f.write("\n".join(lines) + "\n")
    return name


class Env:
    def __init__(self, tmp):
        self.tmp = tmp
        self.home = os.path.join(tmp, "fuzz")
        self.held = os.path.join(self.home, "state", "held")
        os.makedirs(self.held)
        os.chmod(self.held, 0o700)
        self.statedir = os.path.join(tmp, "var-lib-fuzz-filer")
        os.mkdir(self.statedir, 0o700)
        self.ledger = os.path.join(self.statedir, "ledger.tsv")
        self.token = os.path.join(tmp, "filer.env")
        write_token(self.token)
        f = FIRSTS
        rows = [
            ("2026-11-03T01:00:00Z", "kernel-thread", "0", "73900000000", "52000", "61000", "ok",
             COMMIT),
            ("2026-11-03T02:00:00Z", "kernel-thread", "0", f["finding"], "417", "61000",
             "held-finding", COMMIT),
            ("2026-11-03T03:00:00Z", "confined", "1", f["crash"], "0", "61000", "held-crash",
             COMMIT),
            ("2026-11-03T04:00:00Z", "kernel-thread", "2", f["hang"], "0", "300000", "held-hang",
             COMMIT),
        ]
        with open(os.path.join(self.home, "state", "windows.tsv"), "w") as w:
            for r in rows:
                w.write("\t".join(r) + "\n")
        self.names = [
            held_log(self.held, f["finding"], [
                "continuous-fuzz: slot 0: kernel-thread, seeds from %s, accelerator kvm, image x"
                % f["finding"],
                "syscall fuzzer: seed 0x1 step 3: shadow mismatch (replay: "
                "NIFE_SYSCALL_FUZZ_SEEDS=%s:1)" % REPLAY_SEED]),
            held_log(self.held, f["crash"], [
                "continuous-fuzz: slot 1: confined, seeds from %s, accelerator kvm, image x"
                % f["crash"], "kernel PANIC at somewhere"]),
            held_log(self.held, f["hang"], [
                "continuous-fuzz: slot 2: kernel-thread, seeds from %s, accelerator kvm, image x"
                % f["hang"], "(no end line: the bound ran out)"]),
        ]

    def run(self, *extra, api=None):
        argv = ["run", "--fuzz-home", self.home, "--ledger", self.ledger, "--token-file",
                self.token, "--token-group", MY_GROUP, "--api", api or API, "--pace", "0"]
        argv += list(extra)
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = MOD.main(argv)
        text = out.getvalue() + err.getvalue()
        outputs.append(text)
        return code, text

    def ledger_text(self):
        try:
            with open(self.ledger) as f:
                return f.read()
        except FileNotFoundError:
            return ""


def creates():
    return [r for r in STUB.requests if r[0] == "POST"]


def lists():
    return [r for r in STUB.requests if r[0] == "GET"]


def main():
    tmp = tempfile.mkdtemp(prefix="fuzz-filer-selftest.")
    os.chmod(tmp, 0o700)
    try:
        run_tests(tmp)
    finally:
        SERVER.shutdown()
        DECOY.shutdown()
        shutil.rmtree(tmp, ignore_errors=True)
    if failures:
        print("fuzz-filer-selftest: %d FAILED: %s" % (len(failures), ", ".join(failures)))
        return 1
    print("fuzz-filer-selftest: ok")
    return 0


def run_tests(tmp):
    MOD.TOKEN_OWNER_UID = os.geteuid()

    shape_checks()
    # 1. Three held windows, one per class: three creates, each well formed.
    env = Env(os.path.join(tmp, "a"))
    STUB.reset()
    code, text = env.run()
    posts = creates()
    check("first run exits 0", code == 0, text)
    check("first run lists once, then creates three", len(lists()) == 1 and len(posts) == 3,
          STUB.requests)
    check("every request carries the token as a bearer",
          all(r[3] == "Bearer " + TOKEN for r in STUB.requests))
    classes = set()
    for _, _, body, _ in posts:
        v = body["vulnerabilities"]
        good = (len(v) == 1 and v[0]["package"] == {"ecosystem": "other", "name": "nife"} and
                v[0]["vulnerable_version_range"] == "<= " + COMMIT and
                "patched_versions" not in v[0])
        check("a create names the package and range and no patched versions", good, v)
        d = body["description"]
        for want in ("- Class: ", "- Driver: ", "- Commit: " + COMMIT, "cargo xtask test",
                     "- Finding: "):
            check("a description holds %r" % want, want in d)
        check("a description says a person publishes it after the fix, or after 90 days",
              "It stays private until a person publishes it after the fix, or until 90 days after "
              "this report." in d, d)
        check("a description promises no rerun-based publish", "rerun" not in d, d)
        classes.add(d.split("- Class: ")[1].split("\n")[0])
        check("no summary holds a seed",
              not any(s in body["summary"] for s in list(FIRSTS.values()) + [REPLAY_SEED]),
              body["summary"])
    check("one create per class", classes == {"held-finding", "held-crash", "held-hang"}, classes)
    finding_body = [b for _, _, b, _ in posts if "held-finding" in b["summary"]][0]["description"]
    check("a held-finding's replay names the replay seed, count 1",
          "NIFE_SYSCALL_FUZZ_SEEDS=%s:1" % REPLAY_SEED in finding_body, finding_body)
    crash_body = [b for _, _, b, _ in posts if "held-crash" in b["summary"]][0]["description"]
    check("a crash's replay names its window's first seed and count",
          "NIFE_CONFINED_FUZZ_SEEDS=%s:1000000" % FIRSTS["crash"] in crash_body
          and "a_confined_fuzzer" in crash_body, crash_body)
    check("the ledger records three filed", env.ledger_text().count("\tfiled\t") == 3,
          env.ledger_text())
    st = os.stat(env.ledger)
    check("the ledger is mode 0600", (st.st_mode & 0o777) == 0o600)

    # 2. Idempotence: a second run sends nothing at all.
    STUB.requests = []
    code, text = env.run()
    check("second run exits 0 and sends nothing", code == 0 and STUB.requests == [],
          (code, text, STUB.requests))

    # 3. One per finding: the same log under another name is the same finding.
    shutil.copy(os.path.join(env.held, env.names[0]),
                os.path.join(env.held, "20261103T090000Z-%s.log" % FIRSTS["finding"]))
    STUB.requests = []
    code, text = env.run()
    check("a copy of a held log under a second name files nothing", creates() == [],
          STUB.requests)

    # 4. A run that dies after GitHub made the advisory: the next one finds it and creates none.
    first = FIRSTS["odd"]
    with open(os.path.join(env.home, "state", "windows.tsv"), "a") as w:
        w.write("\t".join(("2026-11-03T05:00:00Z", "confined", "3", first, "0", "61000",
                           "held-crash", COMMIT)) + "\n")
    held_log(env.held, first, ["continuous-fuzz: slot 3: confined, seeds from %s, accelerator "
                               "kvm, image x" % first, "panicked at the disco"])
    STUB.requests = []
    STUB.mode = "drop-after-create"
    code, text = env.run()
    check("a create whose answer breaks off exits 1 and leaves the finding pending",
          code == 1 and "\tpending\t-\t" in env.ledger_text().rstrip().splitlines()[-1],
          (code, text))
    STUB.mode = "ok"
    STUB.requests = []
    code, text = env.run()
    check("the next run finds it on GitHub and creates nothing",
          code == 0 and creates() == [] and len(lists()) == 1, (code, text, STUB.requests))
    check("GitHub holds four advisories, one per finding", len(STUB.advisories) == 4)

    # 5. A lost ledger: rebuilt from the listing, no create. The listing is paged.
    os.unlink(env.ledger)
    STUB.requests = []
    STUB.page_size = 3
    code, text = env.run()
    check("a lost ledger is rebuilt from a paged listing with no create",
          code == 0 and creates() == [] and len(lists()) == 2 and
          env.ledger_text().count("\tfiled\t") == 4, (code, text, STUB.requests))
    STUB.page_size = 100

    # 6. A next link that points elsewhere, and a failed listing, file nothing.
    os.unlink(env.ledger)
    STUB.page_size = 2
    STUB.mode = "evil-next"
    STUB.requests = []
    code, text = env.run()
    check("a next link to elsewhere refuses the listing and files nothing",
          code == 1 and creates() == [], (code, text))
    STUB.page_size = 100
    STUB.mode = "list-fails"
    STUB.requests = []
    code, text = env.run()
    check("a failed listing files nothing", code == 1 and creates() == [], (code, text))
    STUB.mode = "ok"
    code, text = env.run()
    check("after the listing recovers, nothing is created twice",
          code == 0 and len(STUB.advisories) == 4)

    # 7. A 422 that echoes the body: pending, nothing printed, then filed once.
    env2 = Env(os.path.join(tmp, "b"))
    STUB.reset()
    STUB.mode = "422-echo"
    code, text = env2.run()
    check("a 422 exits 1 with every finding pending",
          code == 1 and env2.ledger_text().count("\tpending\t") == 3, (code, text))
    STUB.mode = "ok"
    STUB.requests = []
    code, text = env2.run()
    check("the next run files each once", code == 0 and len(creates()) == 3 and
          len(STUB.advisories) == 3, (code, text))

    # 8. A finding whose log and row disagree is refused by id; the others are filed.
    env3 = Env(os.path.join(tmp, "c"))
    with open(os.path.join(env3.held, env3.names[1]), "w") as f:
        f.write("continuous-fuzz: slot 1: kernel-thread, seeds from %s, accelerator kvm\nPANIC\n"
                % FIRSTS["crash"])
    STUB.reset()
    code, text = env3.run()
    check("a disagreeing finding is refused and the other two filed",
          code == 1 and len(creates()) == 2 and "is refused: its log and its row" in text,
          (code, text))

    # 9. Rate: a 403 rate limit stops after one create attempt with 75.
    env4 = Env(os.path.join(tmp, "d"))
    STUB.reset()
    STUB.mode = "rate-403"
    code, text = env4.run()
    check("a 403 rate limit exits 75 after one create attempt", code == 75 and len(creates()) == 1,
          (code, text))
    STUB.reset()
    STUB.mode = "low-after-create"
    code, text = env4.run()
    check("a low remaining count stops the run after one create", code == 75 and
          len(creates()) == 1, (code, text))
    STUB.mode = "ok"
    STUB.remaining = 4999
    STUB.requests = []
    code, text = env4.run("--max", "1")
    check("--max 1 creates one", code == 0 and len(creates()) == 1 and "wait for the next run"
          in text, (code, text))
    STUB.requests = []
    code, text = env4.run()
    check("the next run creates the last", code == 0 and len(creates()) == 1, (code, text))
    STUB.requests = []
    STUB.remaining = 10
    code, text = env4.run()
    check("with nothing to file, a low rate count sends nothing", code == 0 and
          STUB.requests == [])
    STUB.remaining = 4999

    # 10. A redirect is refused and its target hears nothing.
    env5 = Env(os.path.join(tmp, "e"))
    STUB.reset()
    STUB.mode = "redirect"
    code, text = env5.run()
    check("a redirect is refused and the decoy hears nothing",
          code == 1 and DECOY_HITS == [] and "redirect" in text, (code, text, DECOY_HITS))

    # 11. A create answered without a package and range: recorded, reported, never filed twice.
    env6 = Env(os.path.join(tmp, "f"))
    STUB.reset()
    STUB.mode = "no-package"
    code, text = env6.run()
    check("an answer without a package and range exits 1 and is recorded",
          code == 1 and env6.ledger_text().count("\tfiled\t") == 3 and
          "cannot be published" in text, (code, text))
    STUB.mode = "ok"
    STUB.requests = []
    code, _ = env6.run()
    check("and is not filed again", STUB.requests == [])

    # 12. Dry run sends nothing. Then, with a second copy of one log already present, the first
    # real run still makes one advisory per finding.
    env7 = Env(os.path.join(tmp, "g"))
    STUB.reset()
    code, text = env7.run("--dry-run")
    check("--dry-run sends nothing and names three", code == 0 and STUB.requests == [] and
          text.count("would file finding") == 3, (code, text))
    shutil.copy(os.path.join(env7.held, env7.names[2]),
                os.path.join(env7.held, "20261103T235959Z-%s.log" % FIRSTS["hang"]))
    code, text = env7.run()
    check("two copies of one log in a first run make one advisory", code == 0 and
          len(creates()) == 3 and len(STUB.advisories) == 3, (code, text))

    # 13. Token refusals: each exits 3 and sends nothing.
    env8 = Env(os.path.join(tmp, "h"))
    cases = [
        ("the wrong profile", dict(perms="contents:write")),
        ("another repository", dict(repos="nifeos/basalt")),
        ("two repositories", dict(repos="nifeos/nife,nifeos/basalt")),
        ("a stale token", dict(minutes=5)),
        ("an expired token", dict(minutes=-5)),
        ("too long a life", dict(minutes=600)),
        ("mode 0644", dict(mode=0o644)),
        ("mode 0400", dict(mode=0o400)),
    ]
    for what, kw in cases:
        write_token(env8.token, **kw)
        STUB.reset()
        code, text = env8.run()
        check("refuses %s and sends nothing" % what, code == 3 and STUB.requests == [] and
              not os.path.exists(env8.ledger), (code, text))
    os.unlink(env8.token)
    STUB.reset()
    code, text = env8.run()
    check("refuses a missing token file", code == 3 and STUB.requests == [], text)
    write_token(os.path.join(tmp, "elsewhere.env"))
    os.symlink(os.path.join(tmp, "elsewhere.env"), env8.token)
    code, text = env8.run()
    check("refuses a token file reached through a link", code == 3 and STUB.requests == [], text)
    os.unlink(env8.token)
    write_token(env8.token)
    other_group = next((g.gr_name for g in grp.getgrall() if g.gr_gid != os.getegid()), None)
    if other_group:
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = MOD.main(["run", "--fuzz-home", env8.home, "--ledger", env8.ledger,
                             "--token-file", env8.token, "--token-group", other_group,
                             "--api", API])
        text = out.getvalue() + err.getvalue()
        outputs.append(text)
        check("refuses a token file of the wrong group", code == 3 and STUB.requests == [], text)
    code, text = env8.run(api="https://example.com")
    check("refuses an API address that is neither GitHub nor loopback",
          code == 3 and STUB.requests == [], text)
    # Out of process, the owner check is the real one: these files are not root's.
    p = subprocess.run([sys.executable, "-IS", FILER, "run", "--fuzz-home", env8.home, "--ledger",
                        env8.ledger, "--token-file", env8.token, "--token-group", MY_GROUP,
                        "--api", API], capture_output=True, text=True)
    outputs.append(p.stdout + p.stderr)
    check("out of process, refuses a token file not owned by root",
          (os.geteuid() == 0) or (p.returncode == 3 and "not owned by uid 0" in p.stderr and
                                  STUB.requests == []), p.stdout + p.stderr)

    # 14. The ledger's shape, and the lock.
    env9 = Env(os.path.join(tmp, "i"))
    with open(env9.ledger, "w") as f:
        f.write("")
    os.chmod(env9.ledger, 0o644)
    STUB.reset()
    code, text = env9.run()
    check("refuses a ledger of mode 0644", code == 3 and STUB.requests == [], text)
    os.chmod(env9.ledger, 0o600)
    with open(env9.ledger, "a") as f:
        f.write("not a ledger line\n")
    code, text = env9.run()
    check("refuses a ledger with a line it cannot read", code == 3 and STUB.requests == [], text)
    with open(env9.ledger, "w") as f:
        f.write("")
    lk = os.open(env9.ledger + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(lk, fcntl.LOCK_EX)
    try:
        code, text = env9.run()
    finally:
        os.close(lk)
    check("refuses while another run holds the lock", code == 3 and STUB.requests == [], text)

    # 15. The ledger command prints ids and states only.
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        MOD.main(["ledger", "--ledger", env.ledger])
    outputs.append(out.getvalue())
    check("ledger prints four filed findings", out.getvalue().count("\tfiled\tGHSA-") == 4,
          out.getvalue())

    # 17. Cause dedupe. Synthetic logs only: every message, file and seed below is invented.
    seeds17 = []

    def panic_log(first, seed, text, file="system_tests/src/user/invented_tests.rs", line=900,
                  driver="kernel-thread", build=0):
        seeds17.extend([first, seed])
        variable = "NIFE_SYSCALL_FUZZ_SEEDS" if driver == "kernel-thread" else \
            "NIFE_CONFINED_FUZZ_SEEDS"
        return [
            "continuous-fuzz: slot 0: %s, seeds from %s, accelerator kvm, image x" % (driver, first),
            "build: compiled %d crates in %d.%d s" % (100 + build, build, build * 7),
            "[PANIC] panicked at %s:%d:%d:" % (file, line, 5 + build),
            text % {"hex": "0x%x" % (0xabc0 + build * 977), "n": 3 + build * 11,
                    "ms": 40 + build * 13, "list": ", ".join(str(build + k) for k in range(3))}
            + " (replay: %s=%s:1)" % (variable, seed),
        ]

    base = ("fuzzer: seed %(hex)s step %(n)d: invented mismatch of slots [%(list)s] after "
            "%(ms)d ms")

    def mini(name, specs):
        """An Env-like directory holding only the held logs `specs` describe, oldest first:
        (first seed, driver, class, commit, log lines)."""
        e = Env.__new__(Env)
        e.tmp = os.path.join(tmp, name)
        e.home = os.path.join(e.tmp, "fuzz")
        e.held = os.path.join(e.home, "state", "held")
        os.makedirs(e.held)
        os.chmod(e.held, 0o700)
        e.statedir = os.path.join(e.tmp, "var-lib-fuzz-filer")
        os.mkdir(e.statedir, 0o700)
        e.ledger = os.path.join(e.statedir, "ledger.tsv")
        e.token = os.path.join(e.tmp, "filer.env")
        write_token(e.token)
        e.names = []
        e.fids = []
        e.add(specs)
        return e

    def add(e, specs):
        base_time = 1_700_000_000 + len(e.names) * 1000
        with open(os.path.join(e.home, "state", "windows.tsv"), "a") as w:
            for k, (first, driver, status, commit, lines) in enumerate(specs):
                w.write("\t".join(("2026-11-03T01:00:00Z", driver, "0", first, "1", "61000",
                                   status, commit)) + "\n")
                name = held_log(e.held, first, lines)
                path = os.path.join(e.held, name)
                os.utime(path, (base_time + k * 10, base_time + k * 10))
                e.names.append(name)
                with open(path, "rb") as f:
                    e.fids.append(__import__("hashlib").sha256(f.read()).hexdigest()[:16])

    Env.add = add

    def finding(first, driver="kernel-thread", commit="aaa1111", text=base, **kw):
        seed = str(int(first) + 5 + kw.get("build", 0))
        return (first, driver, "held-finding", commit, panic_log(first, seed, text, driver=driver,
                                                                   **kw))

    # Logs of one cause differ in seeds, timings, numbers, line numbers and build lines.
    cause_logs = [finding("7392%07d" % (k * 100), commit="aaa%04d" % k, line=900 + k * 17, build=k)
                  for k in range(5)]
    a = mini("s1", cause_logs)
    STUB.reset()
    code, text = a.run("--dry-run")
    check("a dry run names one finding for five logs of one cause",
          code == 0 and text.count("would file finding") == 1 and "(5 held logs)" in text and
          STUB.requests == [], (code, text))
    code, text = a.run()
    check("five logs that differ in seeds, timings, numbers and line numbers file one advisory",
          code == 0 and len(creates()) == 1 and len(STUB.advisories) == 1, (code, text))
    check("the advisory is for the oldest log",
          "- Finding: %s" % a.fids[0] in STUB.advisories[0]["description"] and
          "aaa0000" in STUB.advisories[0]["description"], STUB.advisories[0]["description"])
    led = a.ledger_text()
    check("the ledger counts the four later logs and keeps the newest commit",
          led.count("\tcause\t") == 1 and "\t4\taaa0004" in led and led.count("\tfiled\t") == 1,
          led)
    check("the filed line carries a signature of 12 hexadecimal digits",
          bool(__import__("re").search(r"\tfiled\tGHSA-[^\t]+\t[0-9a-f]{12}\n", led)), led)
    check("the run's output names counts and signature short forms and no message or file",
          "cause " in text and "5 held logs" in text and "invented" not in text and
          "_tests.rs" not in text and "mismatch" not in text, text)

    # A second run files nothing and sends nothing; the ledger does not grow.
    before = a.ledger_text()
    STUB.requests = []
    code, text = a.run()
    check("a second run files nothing, sends nothing and writes nothing",
          code == 0 and STUB.requests == [] and a.ledger_text() == before, (code, text))

    # A later log of the same cause, at a newer commit, is counted and not filed.
    a.add([finding("7392%07d" % 900, commit="bbb2222", line=1234, build=9)])
    STUB.requests = []
    code, text = a.run()
    check("a later log of a filed cause is not filed and sends nothing",
          code == 0 and STUB.requests == [] and len(STUB.advisories) == 1, (code, text))
    check("its count and newest commit are recorded",
          a.ledger_text().rstrip().splitlines()[-1].endswith("\t5\tbbb2222"), a.ledger_text())

    # Separate signatures: another message, another file, another class, another driver.
    other_class = finding("7393%07d" % 0, text=base)
    other_class = (other_class[0], other_class[1], "held-crash", other_class[3], other_class[4])
    b = mini("s2", [
        finding("7393%07d" % 100),
        finding("7393%07d" % 200, text="fuzzer: seed %(hex)s step %(n)d: invented overflow of "
                                         "slots [%(list)s] after %(ms)d ms"),
        finding("7393%07d" % 300, file="system_tests/src/user/another_invented_tests.rs"),
        (other_class[0], other_class[1], other_class[2], other_class[3], other_class[4]),
        finding("7393%07d" % 400, driver="confined"),
        finding("7393%07d" % 500, line=1, build=3),
    ])
    STUB.reset()
    code, text = b.run()
    check("a different message, file, class and driver each file their own advisory, and the "
          "sixth log, a repeat of the first, does not", code == 0 and len(creates()) == 5, (code, text))

    # Normalization itself.
    t = MOD.template_of
    check("hex, decimal, bracketed lists and the replay suffix are normalized",
          t("seed 0x1f step 3: bad [1, 2] at 12.5 ms (replay: NIFE_X_SEEDS=9:1)") ==
          t("seed 0xABC step 77: bad [] at 3 ms (replay: NIFE_X_SEEDS=1234:1)"))
    check("a number inside a word stays", t("u64 overflow") != t("u32 overflow"))
    sig = MOD.signature_of
    c1 = MOD.cause_of(b"[PANIC] panicked at a/b.rs:10:5:\n", b"boom 3\n", None)
    c2 = MOD.cause_of(b"[PANIC] panicked at a/b.rs:99:1:\n", b"boom 400\n", None)
    c3 = MOD.cause_of(b"[PANIC] panicked at a/c.rs:10:5:\n", b"boom 3\n", None)
    c4 = MOD.cause_of(b"[PANIC] panicked at a/b.rs:10:5:\n", b"bang 3\n", None)
    check("line-number drift does not split a signature, a file or message does",
          sig("d", "held-crash", c1) == sig("d", "held-crash", c2) and
          sig("d", "held-crash", c1) != sig("d", "held-crash", c3) and
          sig("d", "held-crash", c1) != sig("d", "held-crash", c4) and
          sig("d", "held-crash", c1) != sig("d", "held-hang", c1) and
          sig("d", "held-crash", c1) != sig("e", "held-crash", c1))
    check("a panic in the older single-line form parses to the same cause",
          MOD.cause_of(b"thread 'x' panicked at 'boom 5', a/b.rs:3:9\n", None, None) == c1)

    # An old-format ledger (four fields, no signature, no cause line) still reads and refiles
    # nothing: each filed finding covers its own log's cause.
    old = mini("s3", cause_logs[:3])
    stamp = "2026-11-03T05:00:00Z"
    with open(old.ledger, "w") as f:
        f.write("# written before signatures\n%s\t%s\tfiled\tGHSA-2222-3333-4444\n"
                % (stamp, old.fids[0]))
    os.chmod(old.ledger, 0o600)
    check("a four-field ledger still loads",
          MOD.ledger_state(old.ledger_text())[old.fids[0]][:2] == ("filed", "GHSA-2222-3333-4444"))
    STUB.reset()
    code, text = old.run()
    check("an old-format ledger's filed finding covers its cause: nothing is filed or sent",
          code == 0 and STUB.requests == [] and creates() == [], (code, text))
    check("the old line is kept and a cause line is added",
          old.ledger_text().startswith("# written before signatures") and
          old.ledger_text().count("\tcause\t") == 1 and
          "\t2\taaa0002" in old.ledger_text(), old.ledger_text())
    code, _ = old.run()
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        MOD.main(["ledger", "--ledger", old.ledger])
    outputs.append(out.getvalue())
    check("the ledger command prints the cause line", "later logs" in out.getvalue() and
          "\tfiled\tGHSA-2222-3333-4444" in out.getvalue(), out.getvalue())
    with open(old.ledger, "a") as f:
        f.write("%s\t%s\tfiled\tGHSA-2222-3333-4444\tnot-a-signature\n" % (stamp, old.fids[1]))
    code, text = old.run()
    check("a ledger line with a malformed signature is refused", code == 3, (code, text))

    # A signature already in the ledger is not refiled, even when its first log is gone.
    keep = mini("s4", cause_logs[:2])
    STUB.reset()
    code, text = keep.run()
    check("the cause is filed once", code == 0 and len(creates()) == 1, (code, text))
    with open(keep.ledger) as f:
        causes_only = [l for l in f.read().splitlines() if "\tcause\t" in l]
    for n in keep.names:
        os.unlink(os.path.join(keep.held, n))
    with open(keep.ledger, "w") as f:
        f.write("\n".join(causes_only) + "\n")
    keep.add([finding("7394%07d" % 0, commit="ccc3333", line=5, build=4)])
    STUB.requests = []
    code, text = keep.run()
    check("a new log of a signature only the ledger knows is not refiled",
          code == 0 and STUB.requests == [] and len(STUB.advisories) == 1, (code, text))

    # A lost ledger: the listing covers the cause, and a duplicate is still not filed.
    os.unlink(a.ledger)
    STUB.reset()
    STUB.advisories = [{"ghsa_id": "GHSA-2222-3333-4444",
                        "description": "- Finding: %s\n" % a.fids[0]}]
    code, text = a.run()
    check("with the ledger lost, an advisory for one log covers the cause",
          code == 0 and creates() == [] and "\tcause\t" in a.ledger_text() and
          "\t5\tbbb2222" in a.ledger_text() and a.ledger_text().count("\tfiled\t") == 1,
          (code, text, a.ledger_text()))

    # The cap of ten holds across causes.
    many = mini("s5", [finding("7395%07d" % (k * 10),
                               text="fuzzer: invented failure kind-%s here" % "abcdefghijkl"[k])
                       for k in range(12)])
    STUB.reset()
    code, text = many.run()
    check("twelve causes file ten a run and two wait", len(creates()) == 10 and
          "2 findings wait for the next run" in text, (code, text))
    code, text = many.run()
    check("the next run files the last two", len(creates()) == 12 and code == 0, (code, text))

    planted17 = seeds17 + ["invented", "_tests.rs", "mismatch", "overflow", "kind-a"]
    for e in (a, b, old, keep, many):
        outputs.append(e.ledger_text())
        planted17 += e.names
    leaks = sorted({p for p in planted17 for o in outputs if p in o})
    check("no output or ledger holds a seed, a log name, a message or a source file", not leaks,
          leaks)

    # 16. Nothing printed, and no ledger, holds a seed, a held log's name, a replay line or the
    # token.
    planted = list(FIRSTS.values()) + [REPLAY_SEED, TOKEN, "replay:", "NIFE_SYSCALL_FUZZ_SEEDS",
                                       "NIFE_CONFINED_FUZZ_SEEDS", "cargo xtask",
                                       "continuous fuzz host, filed by"]
    for e in (env, env2, env3, env4, env5, env6, env7, env8, env9):
        planted += e.names
        outputs.append(e.ledger_text())
    leaks = sorted({p for p in planted for o in outputs if p in o})
    check("no output or ledger holds a planted seed, name, replay line or token", not leaks, leaks)
    check("the leak scan saw output", sum(len(o) for o in outputs) > 1000)


if __name__ == "__main__":
    sys.exit(main())
