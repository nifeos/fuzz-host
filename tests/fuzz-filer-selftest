def cm_panic(held, name):
    with open(os.path.join(held, name), "rb") as f:
        lines = f.read().splitlines(True)
    return next(l for l in lines if b"panicked at" in l)


def cm_after(held, name):
    with open(os.path.join(held, name), "rb") as f:
        lines = f.read().splitlines(True)
    return lines[[i for i, l in enumerate(lines) if b"panicked at" in l][0] + 1]


def snapshot(top):
    """Every path under `top` with its mode, size, modification time and content hash."""
    seen = {}
    for d, dirs, files in os.walk(top):
        for n in dirs + files:
            p = os.path.join(d, n)
            st = os.lstat(p)
            digest = None
            if os.path.isfile(p) and not os.path.islink(p):
                with open(p, "rb") as f:
                    digest = __import__("hashlib").sha256(f.read()).hexdigest()
            seen[os.path.relpath(p, top)] = (st.st_mode, st.st_size, st.st_mtime_ns, digest)
    return seen


