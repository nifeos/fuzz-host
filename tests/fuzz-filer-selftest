# Section 18 onward share these. Every message, file and seed is invented.
SEEDS18 = []
LOG_NAMES18 = []
BUDGET_TEXT = ("invented wait gave up: %d ms of the counter; ticks taken of %d on each core: "
               "core 0 %d core 1 %d")
FP_TEXT = "fuzzer: seed %(hex)s step %(n)d: invented oracle disagreement on [%(list)s] at %(ms)d ms"


def slot_line(first, driver="kernel-thread"):
    return "continuous-fuzz: slot 0: %s, seeds from %s, accelerator kvm, image x" % (driver, first)


def hang(first, last_lines, commit="ddd1111"):
    """A held hang: no panic and no replay line, the guest's last lines `last_lines`."""
    SEEDS18.append(first)
    return (first, "kernel-thread", "held-hang", commit,
            [slot_line(first), "build: compiled 100 crates in 4.2 s"] + last_lines +
            ["qemu-bounded.sh: the bound of 300 s ran out"])


def budget(first, status="held-crash", k=0, commit="eee1111"):
    """A held window whose driver gave up on the tick budget, as a crash or as a finding."""
    seed = str(int(first) + 3)
    SEEDS18.extend([first, seed])
    msg = BUDGET_TEXT % (2000 + k * 31, 200, 150 + k, 40 + k)
    if status == "held-finding":
        msg += " (replay: NIFE_SYSCALL_FUZZ_SEEDS=%s:1)" % seed
    return (first, "kernel-thread", status, commit,
            [slot_line(first), "[PANIC] panicked at system_tests/src/user/invented_fuzzer.rs:%d:9:"
             % (100 + k), msg])


def tracked(finding):
    """finding(), recording its seeds for the leak scan, with an optional start time."""
    def make(first, started=None, **kw):
        SEEDS18.extend([first, str(int(first) + 5 + kw.get("build", 0))])
        spec = finding(first, **kw)
        return spec + ((started,) if started else ())
    return make


def hang_signature(last, driver="kernel-thread"):
    return MOD.signature_of(driver, "held-hang", MOD.cause_of(None, None, None, last))


def cause_lines(text):
    """{signature: the run's line about it}."""
    return {m.group(1): m.group(0) for m in
            __import__("re").finditer(r"cause ([0-9a-f]{12}) \(\w+\)[^\n]*", text)}


def kinds_rules_archive(tmp, mini, finding):
    finding = tracked(finding)

    # 18. Kinds. A silent hang and a tick budget expiry are parked: counted, never filed. A hang's
    # cause is its last guest line, so hangs that stopped in different places stay apart, and two
    # that differ only in numbers stay together. A budget expiry is parked whatever its class.
    k = mini("t1", [
        hang("7396%07d" % 0, ["invented step 12 of actor 3"]),
        hang("7396%07d" % 10, ["invented step 977 of actor 1"]),
        hang("7396%07d" % 20, ["invented lock wait on slot 4"]),
        budget("7396%07d" % 40, k=0),
        budget("7396%07d" % 50, k=7),
        budget("7396%07d" % 60, status="held-finding", k=2),
        finding("7396%07d" % 70),
    ])
    LOG_NAMES18.extend(k.names)
    STUB.reset()
    code, text = k.run()
    lines = cause_lines(text)
    parked = [l for l in lines.values() if "parked" in l]
    check("hangs and budget expiry are parked and only the panic is filed",
          code == 0 and len(creates()) == 1 and "held-finding" in creates()[0][2]["summary"],
          (code, text))
    check("two hangs that differ only in numbers share a cause; one that stopped elsewhere has its "
          "own", sum(1 for l in parked if "(hang): 2 held logs" in l) == 1 and
          sum(1 for l in parked if "(hang): 1 held logs" in l) == 1, text)
    check("a budget expiry is parked as a crash and as a finding, each its own cause",
          sum(1 for l in parked if "(budget): 2 held logs" in l) == 1 and
          sum(1 for l in parked if "(budget): 1 held logs" in l) == 1, text)
    check("the run's tally counts four parked causes", "4 parked" in text, text)
    STUB.requests = []
    before = k.ledger_text()
    code, text = k.run()
    check("parked causes send nothing and write nothing on the next run",
          code == 0 and STUB.requests == [] and k.ledger_text() == before, (code, text))

    # Hang signatures, directly.
    check("a hang's cause is its last guest line, normalized",
          hang_signature(b"invented step 1 of actor 2\n") ==
          hang_signature(b"invented step 99 of actor 7\n") and
          hang_signature(b"invented step 1 of actor 2\n") !=
          hang_signature(b"invented lock wait on slot 4\n"))
    check("a hang with no guest line at all has the bare hang cause",
          MOD.cause_of(None, None, None, None) == (MOD.HANG_FILE, "-"))
    check("a hang's cause never equals a panic's",
          MOD.cause_of(None, None, None, b"x\n") != MOD.cause_of(b"PANIC x\n", None, None, None))
    check("the kinds", MOD.kind_of("held-hang", MOD.cause_of(None, None, None, b"x\n")) == "hang"
          and MOD.kind_of("held-hang", MOD.cause_of(b"PANIC x\n", None, None, None)) == "panic"
          and MOD.kind_of("held-finding", ("-", "a mismatch")) == "replay"
          and MOD.kind_of("held-finding", ("-", MOD.template_of(BUDGET_TEXT % (1, 2, 3, 4))))
          == "budget")
    check("a panic's signature did not change with kinds: a filed cause is never refiled",
          MOD.signature_of("d", "held-crash", MOD.cause_of(b"panicked at a/b.rs:1:2:\n", b"boom\n",
                                                           None)) ==
          __import__("hashlib").sha256("\0".join(("d", "held-crash", "a/b.rs", "boom"))
                                       .encode()).hexdigest()[:12])

    # 18a. A `file` rule files a parked cause once; its repeat is still deduped.
    lock_wait = hang_signature(b"invented lock wait on slot 4\n")
    write_rules(k.rules, [(lock_wait, "file", "any", "2026-11-04", "selftest: a parked hang to file")])
    STUB.reset()
    code, text = k.run()
    check("a file rule files the parked hang once", code == 0 and len(creates()) == 1 and
          "held-hang" in creates()[0][2]["summary"], (code, text))
    STUB.requests = []
    code, text = k.run()
    check("and the next run files nothing", code == 0 and STUB.requests == [], (code, text))

    # 18b. A suppression wins over a file rule.
    write_rules(k.rules, [
