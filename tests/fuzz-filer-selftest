def budget_expired(first, k, site="actor", backstop=False, cores=2, driver="kernel-thread",
                   commit="eee2222"):
    """A held-budget-expired window as nife's drivers print one: the marker, the site's words, the
    budget's measurements (`<ms> ms of the counter[ (the backstop)]; ticks taken of <n> on each
    core: core <c> <n> ...`), and the thread dump after the panic. Every number, list, address and
    Debug value changes with `k`; the site, the file and the words do not. Invented throughout."""
    seed = str(int(first) + 7 + k)
    SEEDS18.extend([first, seed])
    taken = " ".join("core %d %d" % (c, 31 + k * 13 + c * 5) for c in range(cores))
    measured = "%d ms of the counter%s; ticks taken of 200 on each core: %s" % (
        2000 + k * 97, " (the backstop)" if backstop else "", taken)
    words = ", ".join("[%s]" % ", ".join(str(k + i + j) for j in range(1 + (i + k) % 3))
                      for i in range(1 + k % 3))
    if site == "actor":
        msg = "budget-expired: invented actor %d neither finished nor parked: %s" % (k % 4, measured)
    elif site == "woken":
        msg = ("syscall fuzzer: seed 0x%x step %d: budget-expired: Invented { slot: %d, words: "
               "[%s] } should have woken actor %d with Some(Answer { rets: [%d], at: %x }); it "
               "stayed parked (%s) (replay: NIFE_SYSCALL_FUZZ_SEEDS=%s:1)"
               % (0x5eed + k, 3 + k * 7, k, words, k % 3, k * 11, 0xffff8000001a2b00 + k * 0x9c4,
                  measured, seed))
    else:
        msg = "budget-expired: invented fuzzer %d did not exit (%s)" % (k, measured)
    dump = ["--- thread dump (hang diagnostic; pc* = on-cpu, racy; tour stage %d) ---" % k] + [
        "  thread %d state=%s pc*=0x%x" % (t, ("Blocked", "Runnable")[(t + k) % 2],
                                           0x400000 + t * 64 + k)
        for t in range(2 + k % 3)] + [
        "  core %d: inbox_len=%d ticks=%d" % (c, k % 2, 900 + k) for c in range(cores)] + [
        "--- end thread dump ---"]
    return (first, driver, "held-budget-expired", commit,
            [slot_line(first, driver), "build: compiled %d crates in %d.%d s" % (100 + k, k, k * 3),
             "[PANIC] panicked at system_tests/src/user/invented_fuzzer.rs:%d:%d:"
             % (300 + k * 3, 9 + k), msg] + dump)


def hang_with_dump(first, last, k):
    """A held hang whose guest printed `last`, then a thread dump, then nothing."""
    spec = hang(first, [last])
    lines = spec[4][:-1] + [
        "--- thread dump (hang diagnostic; pc* = on-cpu, racy; tour stage %d) ---" % k,
        "  thread %d state=Blocked pc*=0x%x" % (k, 0x400000 + k),
        "--- end thread dump ---", spec[4][-1]]
    return spec[:4] + (lines,)


