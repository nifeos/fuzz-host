        except SystemExit:
            ok = False
        check("--max %s is %s" % (value, "accepted" if want else "refused"), ok == want)
    check("the ceiling is a few dozen at most and the default is under it",
          MOD.DEFAULT_MAX <= MOD.MAX_CEILING <= 30)

    leaks = sorted({p for p in SEEDS18 + LOG_NAMES18 + ["invented", "Invented", "Answer",
                                                         "thread dump"]
                    for o in outputs if p in o})
    check("no output from section 20 holds a seed, a log name, a message or the dump",
          not leaks, leaks)


if __name__ == "__main__":
    sys.exit(main())
