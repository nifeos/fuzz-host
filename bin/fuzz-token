#!/usr/bin/python3 -IS
"""fuzz-token: mint one narrowed installation token of the nife-fuzz GitHub App for one service.

    fuzz-token mint PROFILE [--reader USER] [--group GROUP] [--key PATH] [--out-dir DIR]
                    [--api URL] [--openssl PATH]
    fuzz-token check PROFILE [--out-dir DIR] [--api URL]
    fuzz-token profiles

`mint` reads the App's private key from a root-only file, signs a JSON Web Token (RS256, through
the `openssl` binary, the key handed over on a pipe), and exchanges it for an installation token
that holds only the profile's permissions on nifeos/nife alone and lives one hour. It refuses the
answer, and revokes the token, when GitHub grants more than it asked for or any other repository.
It writes the token to `<out-dir>/<profile>.env`, owned by root and by the profile's group, mode
0440, in a form both a shell and systemd's `EnvironmentFile=` read. The group must hold the reader
account and no other, as a member or as a primary group; anything else refuses. The reader can read
the file and can neither change its mode nor rewrite it, so a file systemd parses as root stays
root's:

    GH_TOKEN=...
    GH_TOKEN_EXPIRES_AT=2026-11-03T14:00:00Z
    GH_TOKEN_PERMISSIONS=contents:write
    GH_TOKEN_REPOSITORIES=nifeos/nife

`fuzz-token@<profile>.timer` runs `mint` every 20 minutes, so a reader always holds a token with
at least 40 minutes left.

`check` reads that file, asks GitHub which repositories the token reaches, and prints the list,
the expiry and the recorded permissions. It never prints the token. It exits 1 unless the list is
exactly nifeos/nife and the token is unexpired.

`profiles` prints each profile, its permissions, its default reader and its default group.

Each profile's token is narrower than the App, but two profiles whose readers are one account give
no isolation between them: that account holds both tokens. `--reader` and `--group` are per profile,
so a profile gets its own account through a drop-in on its unit, with no change here.

The key never leaves this process except on the pipe to `openssl`. Neither the key nor a token
appears in an argument list, on standard output, on standard error or in an error message, and the
token file is the only place a token is written. The key file must be a regular file (not a link),
owned by the user running this, mode 0400, in a directory owned by that user, mode 0700; anything
else is refused before the file is read. On the host that user is root.

`--reader` and `--group` exist for a drop-in that gives a profile its own account. `--key`,
`--out-dir`, `--api` and `--openssl` exist for the selftest; the installed unit passes none of them.
`--api` accepts https://api.github.com and plain http to a literal loopback address and nothing
else, and the helper refuses every HTTP redirect.

Name: provisional, as are the profile names and the paths. docs/fuzz-token.md has the install
steps for a person with root.

BUGS

- Python cannot wipe memory, so the key and the token stay in this process's heap until it exits.
  The process lives a few seconds.
- GitHub's answer lists the repositories only when the request names them. This helper always names
  nife, and refuses an answer without the list.
- Both profiles default to the reader `lane`, so until each has its own account the split narrows
  each token but isolates nothing between them.
"""

import argparse
import base64
import json
import os
import grp
import ipaddress
import pwd
import re
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone

APP_ID = "5571801"
INSTALLATION_ID = "177641059"
OWNER = "nifeos"
REPOSITORY = "nife"
FULL_NAME = OWNER + "/" + REPOSITORY

DEFAULT_KEY = "/etc/nife-fuzz/nife-fuzz.private-key.pem"
DEFAULT_OUT_DIR = "/run/fuzz-token"
DEFAULT_API = "https://api.github.com"
DEFAULT_OPENSSL = "/usr/bin/openssl"
# openssl runs with this PATH and nothing else in its environment.
OPENSSL_ENV = {"PATH": "/usr/bin:/bin"}
# What GitHub's installation tokens look like today (ghs_ and 36 characters); anything else is
# refused rather than written into a file systemd parses.
TOKEN_SHAPE = re.compile(r"[A-Za-z0-9_]{1,255}")

# One token per service, each narrowed below the App's permissions (Contents write and Repository
# security advisories write; GitHub adds Metadata read to every token). The reader and group are
# defaults; a unit drop-in overrides them per profile.
PROFILES = {
    "publish": {"permissions": {"contents": "write"}, "reader": "lane",
                "what": "the daily fuzz release (gh release create)"},
    "filer": {"permissions": {"repository_advisories": "write"}, "reader": "lane",
              "what": "the finding filer (private security advisories)"},
}
# What GitHub grants beside the request without being asked.
IMPLICIT = {"metadata": "read"}

KEY_MODE = 0o400
KEY_DIR_MODE = 0o700
OUT_DIR_MODE = 0o711
TOKEN_MODE = 0o440
# The token file's owner, whoever runs `check`. The selftest, which cannot make root's files,
# changes it in process.
TOKEN_OWNER_UID = 0
ACL_XATTRS = ("system.posix_acl_access", "system.posix_acl_default")

# Every secret this process has seen; refusal messages pass through redact() before printing.
SECRETS = []


class Refusal(Exception):
    """A failure with a message meant for a person, printed without a traceback."""


def redact(text):
    text = str(text)
    for s in SECRETS:
        if s:
            text = text.replace(s, "[redacted]")
    return text


def b64url(raw):
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


def mode_text(st):
    return "%04o" % stat.S_IMODE(st.st_mode)


def check_key(path, uid):
    """The key's bytes, after checking its directory and the file itself.

    The directory is opened without following a link and checked on its descriptor: a directory
    owned by `uid`, mode 0700. The key is opened relative to that descriptor, again without
    following a link and without blocking on a FIFO, and checked on its own descriptor: a regular
    file owned by `uid`, mode 0400. Anything else refuses before a byte is read."""
    path = os.path.abspath(path)
    directory, name = os.path.split(path)
    try:
        dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        raise Refusal("the key directory %s cannot be opened: %s (a link is refused)"
                      % (directory, e.strerror))
    try:
        dst = os.fstat(dfd)
        if dst.st_uid != uid or stat.S_IMODE(dst.st_mode) != KEY_DIR_MODE:
            raise Refusal("the key directory %s is owned by uid %d with mode %s; it must be uid "
                          "%d, mode %04o" % (directory, dst.st_uid, mode_text(dst), uid,
                                             KEY_DIR_MODE))
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NOCTTY |
                         os.O_NONBLOCK, dir_fd=dfd)
        except OSError as e:
            raise Refusal("the key file %s cannot be opened: %s (a link is refused)"
                          % (path, e.strerror))
    finally:
        os.close(dfd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Refusal("the key file %s is not a regular file" % path)
        if st.st_uid != uid or stat.S_IMODE(st.st_mode) != KEY_MODE:
            raise Refusal("the key file %s is owned by uid %d with mode %s; it must be uid %d, "
                          "mode %04o" % (path, st.st_uid, mode_text(st), uid, KEY_MODE))
        chunks = []
        while True:
            b = os.read(fd, 65536)
            if not b:
                break
            chunks.append(b)
    finally:
        os.close(fd)
    key = b"".join(chunks)
    if b"PRIVATE KEY-----" not in key:
        raise Refusal("the key file %s does not hold a PEM private key" % path)
    return key


def sign_jwt(key, openssl=DEFAULT_OPENSSL, now=None):
    """A JSON Web Token for the App, signed with `key` through `openssl`.

    iat is backdated 60 seconds and exp set 540 seconds ahead, inside GitHub's ten-minute ceiling,
    for clock drift between this host and GitHub. The key travels on openssl's standard input; the
    signing input, which is not secret, goes in a private temporary file."""
    now = int(now if now is not None else time.time())
    header = b64url(json.dumps({"alg": "RS256", "typ": "JWT"}, separators=(",", ":")).encode())
    claims = b64url(json.dumps({"iat": now - 60, "exp": now + 540, "iss": APP_ID},
                               separators=(",", ":")).encode())
    signing_input = "%s.%s" % (header, claims)
    with tempfile.TemporaryDirectory(prefix="fuzz-token.") as tmp:
        data = os.path.join(tmp, "signing-input")
        with open(data, "w") as f:
            f.write(signing_input)
        r = subprocess.run([openssl, "dgst", "-sha256", "-sign", "/dev/stdin", "-binary", data],
                           input=key, capture_output=True, env=OPENSSL_ENV)
    if r.returncode != 0 or not r.stdout:
        raise Refusal("openssl could not sign with the App key (exit %d); is it a PEM RSA "
                      "private key?" % r.returncode)
    token = "%s.%s" % (signing_input, b64url(r.stdout))
    SECRETS.append(token)
    return token


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect would carry the bearer elsewhere, or downgrade it; every one is refused."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise Refusal("GitHub answered %s %s with a redirect (HTTP %d); redirects are refused"
                      % (req.get_method(), urllib.parse.urlsplit(req.full_url).path, code))


OPENER = urllib.request.build_opener(NoRedirect)


def check_api(api):
    """The API base, refused unless it is exactly https://api.github.com, or plain http to a literal
    loopback address (127.0.0.0/8 or ::1, the selftest's stub). No user information, path, query or
    IPv4-mapped address is accepted, and no name but api.github.com is looked up."""
    try:
        u = urllib.parse.urlsplit(api)
        port = u.port
    except ValueError:
        raise Refusal("the API address %s does not parse" % api)
    bare = not (u.username or u.password or u.query or u.fragment or u.path not in ("", "/"))
    if bare and u.scheme == "https" and u.hostname == "api.github.com" and port in (None, 443):
        return api
    if bare and u.scheme == "http" and u.hostname:
        try:
            ip = ipaddress.ip_address(u.hostname)
        except ValueError:
            ip = None
        mapped = getattr(ip, "ipv4_mapped", None)
        if ip is not None and mapped is None and ip.is_loopback:
            return api
    raise Refusal("the API address %s is neither https://api.github.com nor plain http to a "
                  "loopback address" % api)


def call(api, method, path, bearer, body=None):
    """(status, decoded JSON) for one GitHub API call. Refuses on any HTTP error, naming the status
    and GitHub's message, redacted."""
    req = urllib.request.Request(api.rstrip("/") + path, method=method,
                                 data=json.dumps(body).encode() if body is not None else None)
    req.add_header("Authorization", "Bearer " + bearer)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    req.add_header("User-Agent", "nifeos-fuzz-token")
    if body is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with OPENER.open(req, timeout=30) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("message", "")
        except (ValueError, AttributeError):
            msg = ""
        raise Refusal("GitHub answered HTTP %d to %s %s: %s" % (e.code, method, path, redact(msg)))
    except urllib.error.URLError as e:
        raise Refusal("could not reach %s: %s" % (api, redact(e.reason)))
    except ValueError:
        raise Refusal("GitHub's answer to %s %s is not JSON" % (method, path))


def revoke(api, token):
    """Best effort: a token refused for being too wide stops working at once."""
    try:
        call(api, "DELETE", "/installation/token", token)
        return True
    except Refusal:
        return False


def permissions_text(perms):
    return ",".join("%s:%s" % kv for kv in sorted(perms.items()))


def parse_expiry(text):
    try:
        return datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        raise Refusal("the expiry %r is not a UTC timestamp" % (text,))


def exchange(api, jwt, profile):
    """(token, expires_at) narrowed to the profile's permissions on nifeos/nife alone."""
    wanted = PROFILES[profile]["permissions"]
    _, minted = call(api, "POST", "/app/installations/%s/access_tokens" % INSTALLATION_ID, jwt,
                     {"repositories": [REPOSITORY], "permissions": wanted})
    if not isinstance(minted, dict) or not isinstance(minted.get("token"), str) \
            or not minted["token"]:
        raise Refusal("GitHub's answer holds no token")
    token = minted["token"]
    SECRETS.append(token)
    problems = []
    if not TOKEN_SHAPE.fullmatch(token):
        problems.append("the token is not 1 to 255 letters, digits and underscores")
    granted = minted.get("permissions")
    if not isinstance(granted, dict):
        problems.append("the answer names no permissions")
    else:
        extra = {k: v for k, v in granted.items() if wanted.get(k, IMPLICIT.get(k)) != v}
        missing = {k: v for k, v in wanted.items() if granted.get(k) != v}
        if extra:
            problems.append("it grants more than asked: %s" % permissions_text(extra))
        if missing:
            problems.append("it lacks %s" % permissions_text(missing))
    repos = minted.get("repositories")
    names = [r.get("full_name") for r in repos if isinstance(r, dict)] \
        if isinstance(repos, list) else None
    if names != [FULL_NAME]:
        problems.append("it reaches %s, not %s alone"
                        % (", ".join(map(str, names)) if names else "no listed repository",
                           FULL_NAME))
    expires = None
    try:
        expires = parse_expiry(minted.get("expires_at"))
    except Refusal as e:
        problems.append(str(e))
    if problems:
        revoked = revoke(api, token)
        raise Refusal("refused the %s token: %s; %s" % (
            profile, "; ".join(problems),
            "revoked it" if revoked else "could not revoke it, so it lapses within the hour"))
    return token, expires


def prepare_out_dir(out_dir, uid):
    try:
        os.mkdir(out_dir, OUT_DIR_MODE)
        os.chmod(out_dir, OUT_DIR_MODE)
    except FileExistsError:
        pass
    except OSError as e:
        raise Refusal("cannot create %s: %s" % (out_dir, e.strerror))
    st = os.lstat(out_dir)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or \
            stat.S_IMODE(st.st_mode) != OUT_DIR_MODE:
        raise Refusal("the token directory %s must be a directory owned by uid %d, mode %04o; it "
                      "is owned by uid %d with mode %s" % (out_dir, uid, OUT_DIR_MODE, st.st_uid,
                                                          mode_text(st)))
    acl = posix_acls(out_dir)
    if acl:
        raise Refusal("the token directory %s carries a POSIX ACL (%s), which could let another "
                      "account read the token; remove it with setfacl -b -k" % (out_dir,
                                                                               ", ".join(acl)))


def posix_acls(path):
    """The POSIX ACL attributes on `path`, not following a link. A file system without extended
    attributes has none."""
    try:
        names = os.listxattr(path, follow_symlinks=False)
    except OSError:
        return []
    return sorted(n for n in names if n in ACL_XATTRS)


def reader_group(group_name, reader):
    """The group the token file belongs to, after checking that `reader` is in it and that no
    other account is.

    The gid must map back to `group_name`, and every group entry that shares the gid counts: its
    listed members, and every account whose primary group it is. docs/fuzz-token.md lists what this
    cannot see."""
    try:
        g = grp.getgrnam(group_name)
    except KeyError:
        raise Refusal("no group named %s on this host; docs/fuzz-token.md says how to make it"
                      % group_name)
    try:
        canonical = grp.getgrgid(g.gr_gid).gr_name
    except KeyError:
        canonical = None
    if canonical != group_name:
        raise Refusal("the group %s has gid %d, which maps back to %s; the token's group must be "
                      "the only name for its gid" % (group_name, g.gr_gid, canonical))
    sharing = [e for e in grp.getgrall() if e.gr_gid == g.gr_gid]
    names = sorted({e.gr_name for e in sharing} - {group_name})
    if names:
        raise Refusal("the groups %s share gid %d with %s; the token's group must be the only "
                      "name for its gid" % (", ".join(names), g.gr_gid, group_name))
    members = set(g.gr_mem) | {m for e in sharing for m in e.gr_mem} | \
        {p.pw_name for p in pwd.getpwall() if p.pw_gid == g.gr_gid}
    if reader.pw_name not in members:
        raise Refusal("the account %s is not in the group %s" % (reader.pw_name, group_name))
    others = sorted(members - {reader.pw_name})
    if others:
        raise Refusal("the group %s holds %s besides %s; the token's group must hold its reader "
                      "alone" % (group_name, ", ".join(others), reader.pw_name))
    return g


def write_token(out_dir, profile, reader, group, token, expires):
    """Write the token file atomically. Owner (the running user, root on the host), the reader's
    group and mode 0440 are set on the temporary file before a byte of the token goes in, then it
    replaces the old file. The reader can read it and cannot change it."""
    path = os.path.join(out_dir, profile + ".env")
    body = ("# fuzz-token: the %s token, readable by %s through the group %s. Rewritten every 20 "
            "minutes.\nGH_TOKEN=%s\nGH_TOKEN_EXPIRES_AT=%s\nGH_TOKEN_PERMISSIONS=%s\n"
            "GH_TOKEN_REPOSITORIES=%s\n" % (
                profile, reader.pw_name, group.gr_name, token,
                expires.strftime("%Y-%m-%dT%H:%M:%SZ"),
                permissions_text(PROFILES[profile]["permissions"]), FULL_NAME))
    fd, tmp = tempfile.mkstemp(dir=out_dir, prefix="." + profile + ".")
    try:
        os.fchown(fd, os.geteuid(), group.gr_gid)
        os.fchmod(fd, TOKEN_MODE)
        os.write(fd, body.encode())
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(tmp, path)
    except OSError as e:
        if fd is not None:
            os.close(fd)
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise Refusal("cannot write %s: %s" % (path, e.strerror))
    return path


def read_token_file(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NOCTTY |
                     os.O_NONBLOCK)
    except OSError as e:
        raise Refusal("the token file %s cannot be opened: %s (a link is refused)"
                      % (path, e.strerror))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Refusal("the token file %s is not a regular file" % path)
        text = os.read(fd, 65536).decode(errors="replace")
    finally:
        os.close(fd)
    fields = {}
    for line in text.splitlines():
        if line and not line.startswith("#"):
            k, _, v = line.partition("=")
            fields[k] = v
    if fields.get("GH_TOKEN"):
        SECRETS.append(fields["GH_TOKEN"])
    else:
        raise Refusal("the token file %s holds no GH_TOKEN" % path)
    return st, fields


def reader_account(name):
    try:
        return pwd.getpwnam(name)
    except KeyError:
        raise Refusal("no account named %s on this host" % name)


def discard_stale(api, out_dir, profile):
    """Remove the profile's token file and revoke the token in it, after the reader or its group
    stopped passing, so a file made for the old group does not stay readable. Says what it did."""
    path = os.path.join(out_dir, profile + ".env")
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return "no earlier token file to remove"
    except OSError as e:
        return "could not inspect %s: %s" % (path, e.strerror)
    token = None
    if stat.S_ISREG(st.st_mode):
        try:
            token = read_token_file(path)[1]["GH_TOKEN"]
        except Refusal:
            token = None
    try:
        os.unlink(path)
    except OSError as e:
        return "could not remove %s: %s" % (path, e.strerror)
    if token is None:
        return "removed %s, which held no readable token" % path
    if TOKEN_SHAPE.fullmatch(token) and revoke(api, token):
        return "removed %s and revoked its token" % path
    return "removed %s; could not revoke its token, so it lapses within the hour" % path


def mint(args):
    profile = args.profile
    api = check_api(args.api)
    try:
        reader = reader_account(args.reader or PROFILES[profile]["reader"])
        group = reader_group(args.group or "fuzz-token-" + profile, reader)
    except Refusal as e:
        raise Refusal("%s; %s" % (e, discard_stale(api, args.out_dir, profile)))
    uid = os.geteuid()
    key = check_key(args.key, uid)
    prepare_out_dir(args.out_dir, uid)
    jwt = sign_jwt(key, args.openssl)
    del key
    token, expires = exchange(api, jwt, profile)
    path = write_token(args.out_dir, profile, reader, group, token, expires)
    print("fuzz-token: wrote %s for %s (group %s): %s on %s, expires %s" % (
        path, reader.pw_name, group.gr_name, permissions_text(PROFILES[profile]["permissions"]), FULL_NAME,
        expires.strftime("%Y-%m-%dT%H:%M:%SZ")))
    return 0


def check(args):
    path = os.path.join(args.out_dir, args.profile + ".env")
    st, fields = read_token_file(path)
    try:
        owner = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        owner = "uid %d" % st.st_uid
    try:
        group = grp.getgrgid(st.st_gid).gr_name
    except KeyError:
        group = "gid %d" % st.st_gid
    expires = parse_expiry(fields.get("GH_TOKEN_EXPIRES_AT"))
    left = int((expires - datetime.now(timezone.utc)).total_seconds())
    _, listing = call(check_api(args.api), "GET", "/installation/repositories?per_page=100",
                      fields["GH_TOKEN"])
    repos = listing.get("repositories") if isinstance(listing, dict) else None
    names = sorted(r.get("full_name", "?") for r in repos if isinstance(r, dict)) \
        if isinstance(repos, list) else []
    print("profile: %s" % args.profile)
    print("file: %s (owner %s, group %s, mode %s)" % (path, owner, group, mode_text(st)))
    print("permissions: %s" % fields.get("GH_TOKEN_PERMISSIONS", "unrecorded"))
    print("expires: %s (%s)" % (fields["GH_TOKEN_EXPIRES_AT"],
                                "in %d minutes" % (left // 60) if left > 0 else "expired"))
    acl = posix_acls(path)
    print("repositories: %s" % (" ".join(names) or "none"))
    if acl:
        print("acl: %s" % ", ".join(acl))
    problems = []
    want_group = args.group or "fuzz-token-" + args.profile
    if group != want_group:
        problems.append("the file's group must be %s" % want_group)
    if acl:
        problems.append("the file must carry no POSIX ACL")
    if names != [FULL_NAME]:
        problems.append("the token must reach %s alone" % FULL_NAME)
    if left <= 0:
        problems.append("the token has expired; is fuzz-token@%s.timer running?" % args.profile)
    if stat.S_IMODE(st.st_mode) != TOKEN_MODE:
        problems.append("the file's mode must be %04o" % TOKEN_MODE)
    if st.st_uid != TOKEN_OWNER_UID:
        problems.append("the file must be owned by uid %d (root)" % TOKEN_OWNER_UID)
    for p in problems:
        print("fuzz-token: %s" % p, file=sys.stderr)
    return 1 if problems else 0


def profiles(_args):
    for name, p in sorted(PROFILES.items()):
        print("%s\t%s\treader %s\tgroup fuzz-token-%s\t%s" % (
            name, permissions_text(p["permissions"]), p["reader"], name, p["what"]))
    return 0


def main(argv):
    ap = argparse.ArgumentParser(prog="fuzz-token",
                                 description="Mint narrowed nife-fuzz installation tokens.")
    sub = ap.add_subparsers(dest="command", required=True)
    m = sub.add_parser("mint", help="mint a token and write it for the reader")
    m.add_argument("profile", choices=sorted(PROFILES))
    m.add_argument("--reader", help="the account that may read the token file")
    m.add_argument("--group", help="the token file's group; it must hold the reader alone")
    m.add_argument("--key", default=DEFAULT_KEY)
    m.add_argument("--out-dir", default=DEFAULT_OUT_DIR)
    m.add_argument("--api", default=DEFAULT_API)
    m.add_argument("--openssl", default=DEFAULT_OPENSSL)
    m.set_defaults(run=mint)
    c = sub.add_parser("check", help="print the token's repositories and expiry, never the token")
    c.add_argument("profile", choices=sorted(PROFILES))
    c.add_argument("--group", help="the group the file must have, if not fuzz-token-PROFILE")
    c.add_argument("--out-dir", default=DEFAULT_OUT_DIR)
    c.add_argument("--api", default=DEFAULT_API)
    c.set_defaults(run=check)
    p = sub.add_parser("profiles", help="list the profiles")
    p.set_defaults(run=profiles)
    args = ap.parse_args(argv)
    try:
        return args.run(args)
    except Refusal as e:
        print("fuzz-token: %s" % redact(e), file=sys.stderr)
        return 3
    except Exception as e:  # noqa: BLE001; a traceback could carry a secret in a local's repr
        print("fuzz-token: internal error (%s); nothing more is printed, because the message "
              "could carry a secret" % type(e).__name__, file=sys.stderr)
        return 4


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
