#!/bin/sh
# script/test: run every selftest under tests/.
#
#     script/test
#
# A selftest is an executable file in tests/ whose name ends in -selftest. Each one runs from the
# repository root, needs no network and no real credential, and exits non-zero on failure. This
# script runs them all, names each failure, and exits 1 when any failed or when none was found.
#
# Name: provisional.

set -u

cd "$(dirname "$0")/.." || exit 1

ran=0
failed=""
for t in tests/*-selftest; do
    [ -x "$t" ] || continue
    ran=$((ran + 1))
    echo "== $t"
    if ! "$t"; then
        failed="$failed $t"
    fi
done

if [ "$ran" -eq 0 ]; then
    echo "script/test: no selftest found under tests/" >&2
    exit 1
fi
if [ -n "$failed" ]; then
    echo "script/test: FAILED:$failed" >&2
    exit 1
fi
echo "script/test: $ran selftests passed"
